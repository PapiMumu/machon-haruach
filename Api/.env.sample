# Copy to .env for local development (never commit .env)

ENVIRONMENT=dev
SERVER_PORT=8084
ENCRYPTION_KEY=replace-with-24-byte-secret
JWT_SECRET=replace-with-jwt-secret
FILE_STORE=disk
CORS_ORIGIN=*

MEMBERSHIP_CONNECTION_STRING=mysql://user:password@localhost:3306/membership
CONTENT_CONNECTION_STRING=mysql://user:password@localhost:3306/content
GIVING_CONNECTION_STRING=mysql://user:password@localhost:3306/giving
MESSAGING_CONNECTION_STRING=mysql://user:password@localhost:3306/messaging
ATTENDANCE_CONNECTION_STRING=mysql://user:password@localhost:3306/attendance
DOING_CONNECTION_STRING=mysql://user:password@localhost:3306/doing
DOING_MEMBERSHIP_CONNECTION_STRING=mysql://user:password@localhost:3306/membership
REPORTING_CONNECTION_STRING=mysql://user:password@localhost:3306/reporting
